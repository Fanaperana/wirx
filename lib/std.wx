// wirx standard library. Always available: no `use` needed.
//
// Footprint aliases: R, C, L, LED and Fuse parts accept an imperial size as their second argument
// (`C(100nF, 0402)`), which expands to the full KiCad footprint name.
//
// Generated families (no declaration needed):
//   Conn_01xNN          single-row header, NN pins (Conn_01x04)
//   Conn_02xNN          dual-row header, odd pins left, even pins right (Conn_02x03 = 6 pins)

// ---------------------------------------------------------------- rails (power symbols)
// Any net whose name starts with + or - (e.g. +3V3, -12V) is a rail too.

rail GND, GNDA, AGND, DGND, PGND, VSS : ground
rail VCC, VDD, VBUS, VBAT, VDDA, AVCC : supply
rail VEE : negative

// ---------------------------------------------------------------- passives

part R {
  prefix "R"  symbol resistor  value "10k"
  description "Resistor"
  footprint "Resistor_SMD:R_0603_1608Metric"
  pins { 1 ~  2 ~ }
}

part C {
  prefix "C"  symbol capacitor  value "100nF"
  description "Unpolarized capacitor"
  footprint "Capacitor_SMD:C_0603_1608Metric"
  pins { 1 ~  2 ~ }
}

part C_Pol {
  prefix "C"  symbol cap_polarized  value "10uF"
  description "Polarized capacitor (electrolytic, tantalum)"
  footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.00mm"
  pins { 1 "+"  2 "-" }
}

part L {
  prefix "L"  symbol inductor  value "10uH"
  description "Inductor"
  footprint "Inductor_SMD:L_0805_2012Metric"
  pins { 1 ~  2 ~ }
}

part Fuse {
  prefix "F"  symbol fuse  value "500mA"
  description "Fuse or polyfuse"
  footprint "Fuse:Fuse_1206_3216Metric"
  pins { 1 ~  2 ~ }
}

part Crystal {
  prefix "Y"  symbol crystal  value "16MHz"
  description "Two-pin crystal"
  footprint "Crystal:Crystal_HC49-4H_Vertical"
  pins { 1 1  2 2 }
}

// ---------------------------------------------------------------- diodes

part D {
  prefix "D"  symbol diode  value "1N4148W"
  description "Diode"
  footprint "Diode_SMD:D_SOD-123"
  pins { 1 K  2 A }
}

part D_Schottky {
  prefix "D"  symbol schottky  value "BAT54"
  description "Schottky diode"
  footprint "Diode_SMD:D_SOD-123"
  pins { 1 K  2 A }
}

part D_Zener {
  prefix "D"  symbol zener  value "BZX84C5V1"
  description "Zener diode"
  footprint "Diode_SMD:D_SOD-123"
  pins { 1 K  2 A }
}

part LED {
  prefix "D"  symbol led  value "LED"
  description "Light emitting diode"
  footprint "LED_SMD:LED_0603_1608Metric"
  pins { 1 K  2 A }
}

// ---------------------------------------------------------------- transistors

part Q_NPN {
  prefix "Q"  symbol npn  value "MMBT3904"
  description "NPN transistor"
  footprint "Package_TO_SOT_SMD:SOT-23"
  pins { 1 B : input  3 C  2 E }
}

part Q_PNP {
  prefix "Q"  symbol pnp  value "MMBT3906"
  description "PNP transistor"
  footprint "Package_TO_SOT_SMD:SOT-23"
  pins { 1 B : input  3 C  2 E }
}

part Q_NMOS {
  prefix "Q"  symbol nmos  value "2N7002"
  description "N-channel MOSFET"
  footprint "Package_TO_SOT_SMD:SOT-23"
  pins { 1 G : input  3 D  2 S }
}

part Q_PMOS {
  prefix "Q"  symbol pmos  value "AO3401A"
  description "P-channel MOSFET"
  footprint "Package_TO_SOT_SMD:SOT-23"
  pins { 1 G : input  3 D  2 S }
}

// ---------------------------------------------------------------- switches

part SW_Push {
  prefix "SW"  symbol button  value "SW_Push"
  description "Push button, normally open"
  footprint "Button_Switch_SMD:SW_SPST_TL3342"
  pins { 1 1  2 2 }
}

part SW_SPST {
  prefix "SW"  symbol switch  value "SW_SPST"
  description "Single pole single throw switch"
  footprint "Button_Switch_THT:SW_Slide_1P2T_CK_OS102011MS2Q"
  pins { 1 1  2 2 }
}

// ---------------------------------------------------------------- ICs

part AMS1117_3V3 {
  prefix "U"  value "AMS1117-3.3"
  description "1A low dropout regulator, 3.3V"
  footprint "Package_TO_SOT_SMD:SOT-223-3_TabPin2"
  datasheet "http://www.advanced-monolithic.com/pdf/ds1117.pdf"
  pins {
    3 VIN  : power_in
    2 VOUT : power_out
    1 GND  : power_in
  }
}

part NE555 {
  prefix "U"  value "NE555"
  description "Precision timer"
  footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
  pins {
    2 TR   : input
    6 THR  : input
    5 CV   : input
    4 R    : input
    3 Q    : output
    7 DIS  : open_collector
    8 VCC  : power_in
    1 GND  : power_in
  }
}

part USB_C_Power {
  prefix "J"  value "USB_C_Receptacle_PowerOnly_6P"
  description "USB Type-C receptacle, power only (6 pins)"
  footprint "Connector_USB:USB_C_Receptacle_GCT_USB4125-xx-x-0190_6P_TopMnt_Horizontal"
  pins {
    A9, B9 VBUS  : passive @right
    A5     CC1   : bidirectional @right
    B5     CC2   : bidirectional @right
    A12, B12 GND : passive @right
    S1     SHIELD : passive @right
  }
}
