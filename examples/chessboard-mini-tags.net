(export (version "E")
  (design (source "examples/chessboard-mini-tags.wx") (tool "wirx 0.1.0"))
  (components
    (comp (ref "C1") (value "2.4nF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Piece") (value "Pawn"))
      (property (name "Tolerance") (value "1%"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C2") (value "100pF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Function") (value "Tag trim"))
      (property (name "Tolerance") (value "1%"))
      (property (name "dnp"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C3") (value "1.3nF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Piece") (value "Knight"))
      (property (name "Tolerance") (value "1%"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C4") (value "100pF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Function") (value "Tag trim"))
      (property (name "Tolerance") (value "1%"))
      (property (name "dnp"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C5") (value "330pF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Piece") (value "Rook"))
      (property (name "Tolerance") (value "1%"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C6") (value "100pF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Function") (value "Tag trim"))
      (property (name "Tolerance") (value "1%"))
      (property (name "dnp"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C7") (value "180pF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Piece") (value "Queen"))
      (property (name "Tolerance") (value "1%"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "C8") (value "100pF") (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "wirx") (part "C") (description "Unpolarized capacitor"))
      (property (name "Dielectric") (value "C0G/NP0"))
      (property (name "Function") (value "Tag trim"))
      (property (name "Tolerance") (value "1%"))
      (property (name "dnp"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "L1") (value "~10uH flat coil") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "wirx") (part "Pawn_TAG_COIL") (description "Pawn tag coil: ready-made flat spiral coil (15-25 mm) in the piece base, soldered to the tag's two pads. Measure L before choosing the capacitor"))
      (property (name "Piece") (value "Pawn"))
      (property (name "Resonance") (value "1.03MHz"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "L2") (value "~10uH flat coil") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "wirx") (part "Knight_TAG_COIL") (description "Knight tag coil: ready-made flat spiral coil (15-25 mm) in the piece base, soldered to the tag's two pads. Measure L before choosing the capacitor"))
      (property (name "Piece") (value "Knight"))
      (property (name "Resonance") (value "1.40MHz"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "L3") (value "~10uH flat coil") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "wirx") (part "Rook_TAG_COIL") (description "Rook tag coil: ready-made flat spiral coil (15-25 mm) in the piece base, soldered to the tag's two pads. Measure L before choosing the capacitor"))
      (property (name "Piece") (value "Rook"))
      (property (name "Resonance") (value "2.77MHz"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
    (comp (ref "L4") (value "~10uH flat coil") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "wirx") (part "Queen_TAG_COIL") (description "Queen tag coil: ready-made flat spiral coil (15-25 mm) in the piece base, soldered to the tag's two pads. Measure L before choosing the capacitor"))
      (property (name "Piece") (value "Queen"))
      (property (name "Resonance") (value "3.75MHz"))
      (sheetpath (names "/Piece tags/") (tstamps "/")))
  )
  (nets
    (net (code "1") (name "Net-(C1-Pad1)")
      (node (ref "C1") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "C2") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "L1") (pin "1") (pinfunction "A") (pintype "passive"))
    )
    (net (code "2") (name "Net-(C1-Pad2)")
      (node (ref "C1") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C2") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "L1") (pin "2") (pinfunction "B") (pintype "passive"))
    )
    (net (code "3") (name "Net-(C3-Pad1)")
      (node (ref "C3") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "C4") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "L2") (pin "1") (pinfunction "A") (pintype "passive"))
    )
    (net (code "4") (name "Net-(C3-Pad2)")
      (node (ref "C3") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C4") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "L2") (pin "2") (pinfunction "B") (pintype "passive"))
    )
    (net (code "5") (name "Net-(C5-Pad1)")
      (node (ref "C5") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "C6") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "L3") (pin "1") (pinfunction "A") (pintype "passive"))
    )
    (net (code "6") (name "Net-(C5-Pad2)")
      (node (ref "C5") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C6") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "L3") (pin "2") (pinfunction "B") (pintype "passive"))
    )
    (net (code "7") (name "Net-(C7-Pad1)")
      (node (ref "C7") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "C8") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "L4") (pin "1") (pinfunction "A") (pintype "passive"))
    )
    (net (code "8") (name "Net-(C7-Pad2)")
      (node (ref "C7") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C8") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "L4") (pin "2") (pinfunction "B") (pintype "passive"))
    )
  )
)
