// 3.3 V supply from USB-C: connector, fuse, LDO with input/output caps and a power LED.
title("USB-C to 3.3V");
revision("A");

fn ldo(vin, vout) {
    let u = AMS1117_3V3();
    vin  -> u.VIN  -> C("10uF", "0805") -> GND;
    vout -> u.VOUT -> C("22uF", "0805") -> GND;
    u.GND -> GND;
}

fn power_led(rail) {
    rail -> R("1k", "0603") -> LED("green", "0603") -> GND;
}

sheet("Power", || {
    let vbus = VBUS.driven();
    GND.driven();

    let j = USB_C_Power();
    j.VBUS -> Fuse("500mA", "1206") -> vbus;
    [j.GND, j.SHIELD] -> GND;
    j.CC1 -> R("5k1", "0603") -> GND;
    j.CC2 -> R("5k1", "0603") -> GND;

    ldo(vbus, P3V3);
    power_led(P3V3);
});
