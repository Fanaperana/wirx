// Astable NE555 LED blinker, about 1.4 Hz, powered from a 2-pin header.
title("NE555 blinker");
revision("A");

fn astable(vcc, out) {
    let u  = NE555();
    let ra = R("10k", "0603");
    let rb = R("47k", "0603");
    let ct = C("10uF", "0805");
    let cd = C("100nF", "0603");

    vcc -> [u.VCC, u.R, ra[1], cd[1]];
    ra[2] -> u.DIS -> rb[1];
    rb[2] -> [u.THR, u.TR, ct[1]];
    u.CV -> C("10nF", "0603") -> GND;
    [u.GND, ct[2], cd[2]] -> GND;
    u.Q -> out;

    near(cd, u.VCC);
}

fn indicator(drive) {
    drive -> R("470", "0603") -> LED("red", "0603") -> GND;
}

let j = Conn(2);
j[1] -> P5V.driven();
j[2] -> GND.driven();

let blink = net("BLINK");
astable(P5V, blink);
indicator(blink);
