// ATmega328P board: USB-C 5 V input, 16 MHz crystal, reset, ISP header, status LEDs, I/O header.
// Shows custom parts, functions as groups, loops and multi-sheet output.
title("ATmega328P minimal board");
revision("1");

fn ATmega328P() {
    part(#{
        name: "ATmega328P",
        prefix: "U",
        value: "ATmega328P-AU",
        footprint: "Package_QFP:TQFP-32_7x7mm_P0.8mm",
        datasheet: "https://ww1.microchip.com/downloads/en/DeviceDoc/ATmega48A-PA-88A-PA-168A-PA-328-P-DS-DS40002061A.pdf",
        pins: [
            [29,         "~RESET", input],
            [7,          "XTAL1",  input],
            [8,          "XTAL2",  output, left],
            [20,         "AREF",   passive],
            [12,         "PB0",    bidirectional, right],
            [13,         "PB1",    bidirectional, right],
            [14,         "PB2",    bidirectional, right],
            [15,         "PB3",    bidirectional, right],
            [16,         "PB4",    bidirectional, right],
            [17,         "PB5",    bidirectional, right],
            [23,         "PC0",    bidirectional, right],
            [24,         "PC1",    bidirectional, right],
            [25,         "PC2",    bidirectional, right],
            [26,         "PC3",    bidirectional, right],
            [27,         "PC4",    bidirectional, right],
            [28,         "PC5",    bidirectional, right],
            [30,         "PD0",    bidirectional, right],
            [31,         "PD1",    bidirectional, right],
            [32,         "PD2",    bidirectional, right],
            [1,          "PD3",    bidirectional, right],
            [[4, 6],     "VCC",    power_in],
            [18,         "AVCC",   power_in],
            [[3, 5, 21], "GND",    power_in],
            [19,         "ADC6",   input, left],
            [22,         "ADC7",   input, left],
        ],
    })
}

fn crystal_16mhz(x1, x2) {
    let y = Crystal("16MHz");
    x1 -> y[1] -> C("22pF", "0603") -> GND;
    x2 -> y[2] -> C("22pF", "0603") -> GND;
}

fn reset(rst) {
    P5V -> R("10k", "0603") -> rst;
    rst -> SW_Push() -> GND;
    rst -> C("100nF", "0603") -> GND;
}

fn mcu(rst, spi, led, uart, adc) {
    let u = ATmega328P();
    P5V -> [u.VCC, u.AVCC];
    u.VCC -> C("100nF", "0603") -> GND;
    u.AVCC -> C("100nF", "0603") -> GND;
    u.GND -> GND;
    u.AREF -> C("100nF", "0603") -> GND;
    crystal_16mhz(u.XTAL1, u.XTAL2);

    rst -> u["~RESET"];
    spi.sck -> u.PB5;
    spi.miso -> u.PB4;
    spi.mosi -> u.PB3;
    led -> u.PB1;
    uart.rx -> u.PD0;
    uart.tx -> u.PD1;
    adc[0] -> u.PC0;
    adc[1] -> u.PC1;
    nc([u.PB0, u.PB2, u.PC2, u.PC3, u.PC4, u.PC5, u.PD2, u.PD3, u.ADC6, u.ADC7]);
}

fn status_led(drive) {
    drive -> R("330", "0603") -> LED("yellow", "0603") -> GND;
}

// Nets shared between sheets.
let rst  = net("RESET");
let spi  = #{ sck: net("SCK"), miso: net("MISO"), mosi: net("MOSI") };
let uart = #{ rx: net("RXD"), tx: net("TXD") };
let adc  = [net("A0"), net("A1")];
let led  = net("LED");

sheet("Power", || {
    let j = USB_C_Power();
    j.VBUS -> P5V.driven();
    [j.GND, j.SHIELD] -> GND.driven();
    j.CC1 -> R("5k1", "0603") -> GND;
    j.CC2 -> R("5k1", "0603") -> GND;
    P5V -> C("10uF", "0805") -> GND;
    status_led(P5V);
});

sheet("MCU", || {
    mcu(rst, spi, led, uart, adc);
    reset(rst);
    status_led(led);
});

sheet("Connectors", || {
    let isp = Conn2(3);
    isp[1] -> spi.miso;
    isp[2] -> P5V;
    isp[3] -> spi.sck;
    isp[4] -> spi.mosi;
    isp[5] -> rst;
    isp[6] -> GND;

    let io = Conn(6);
    io[1] -> uart.rx;
    io[2] -> uart.tx;
    io[3] -> adc[0];
    io[4] -> adc[1];
    io[5] -> P5V;
    io[6] -> GND;
});
